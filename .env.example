# ==========================================================================
# portfolio-go — variables de entorno
# En producción (Dokploy) estas se configuran en el Environment del servicio.
# En desarrollo local se copian a .env (gitignored).
# ==========================================================================

# PostgreSQL — en Dokploy apunta al servicio db interno, ej:
#   postgres://portafolio:TU_PASSWORD@postgres:5432/portfolio_go?sslmode=disable
DATABASE_URL=postgres://postgres@localhost:5432/portfolio_go?sslmode=disable

# Servidor
SERVER_PORT=8080
APP_ENV=production
