# ==========================================================================
# portfolio-go — variables de entorno
# En producción (Dokploy) estas se configuran en el Environment del servicio.
# En desarrollo local se copian a .env (gitignored).
# ==========================================================================

# PostgreSQL — en Dokploy apunta al servicio db interno, ej:
#   postgres://portafolio:TU_PASSWORD@postgres:5432/portfolio_go?sslmode=disable
DATABASE_URL=postgres://postgres@localhost:5432/portfolio_go?sslmode=disable

# Servidor
SERVER_PORT=8080
APP_ENV=production

# Cloudinary — subida de imágenes (WebP convertido en local, solo almacena/entrega)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — envío del formulario de contacto
RESEND_API_KEY=
# Destinatario real del formulario (nunca renderizado en pantalla)
CONTACT_EMAIL=
# Remitente verificado en Resend (dominio propio verificado, ej. no-reply@tudominio.dev)
CONTACT_FROM=Portafolio <no-reply@tudominio.dev>
