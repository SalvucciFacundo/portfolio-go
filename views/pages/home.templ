package pages

import (
	"github.com/SalvucciFacundo/portfolio-go/internal/domain"
	"github.com/SalvucciFacundo/portfolio-go/views/components"
	"github.com/SalvucciFacundo/portfolio-go/views/layouts"
	"github.com/SalvucciFacundo/portfolio-go/views/sections"
)

templ Home(p domain.Profile, lang string, isAdmin bool) {
	@layouts.Base(lang) {
		<div class="frame">
			@components.Watermark()
			@components.SidebarLeft(p, lang, isAdmin)
			@components.SidebarRight(lang)
			<main class="main-content">
				@sections.Hero(p, lang, isAdmin)
				@sections.Skills(p, lang, isAdmin)
				@sections.Projects(p, lang, isAdmin)
				@sections.Experience(p, lang, isAdmin)
				@sections.Education(p, lang, isAdmin)
				@sections.Contact(p, lang, isAdmin)
			</main>
		</div>
		if !isAdmin {
			@components.LoginModal()
		}
		if isAdmin {
			@components.HeroEditModal(p)
			@components.SkillsAdminModal(p)
			@components.ProjectsAdminModal(p)
			@components.EducationAdminModal(p)
			@components.ExperienceAdminModal(p)
			@components.SocialsAdminModal(p)
		}
	}
}
