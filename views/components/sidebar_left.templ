package components

import (
	"github.com/SalvucciFacundo/portfolio-go/internal/domain"
	"github.com/SalvucciFacundo/portfolio-go/internal/i18n"
)

templ SidebarLeft(p domain.Profile, lang string) {
	<aside class="sidebar sidebar-left" aria-label={ i18n.T(lang, "sidebar.aria") }>
		<div class="sidebar-left__icons">
			<button
				type="button"
				class="icon-btn theme-toggle"
				id="theme-toggle"
				aria-pressed="false"
				aria-label={ i18n.T(lang, "theme.to_dark") }
			>
				<span class="icon icon-sun">@sunIcon()</span>
				<span class="icon icon-moon">@moonIcon()</span>
			</button>
			<a
				class="icon-btn lang-toggle"
				href={ otherLangHref(lang) }
				aria-label={ i18n.T(lang, "lang.switch_to") }
			>
				if lang == "en" {
					@flagEsIcon()
				} else {
					@flagEnIcon()
				}
			</a>
			<div class="sidebar-left__divider" role="separator"></div>
			<div class="sidebar-left__socials">
				for _, s := range p.Socials {
					<a
						class="icon-btn social-link grayscale-reveal"
						style={ brandStyle(s.IconKey) }
						href={ s.URL }
						target="_blank"
						rel="noopener noreferrer"
						aria-label={ s.Name }
					>
						switch s.IconKey {
						case "github":
							@githubIcon()
						case "linkedin":
							@linkedinIcon()
						}
					</a>
				}
				@CopyEmail(p.Email, "", i18n.T(lang, "action.copied"), i18n.T(lang, "action.copy_email"))
			</div>
		</div>
	</aside>
}
