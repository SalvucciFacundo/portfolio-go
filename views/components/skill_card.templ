package components

import "github.com/SalvucciFacundo/portfolio-go/internal/domain"

templ SkillCard(s domain.Skill, lang string) {
	<article class="skill-card">
		<img class="skill-card__icon grayscale-reveal" src={ s.IconURL } alt={ s.Name } width="28" height="28" loading="lazy"/>
		<span class="skill-card__name">{ s.Name }</span>
	</article>
}
