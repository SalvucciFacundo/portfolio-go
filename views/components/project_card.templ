package components

import (
	"github.com/SalvucciFacundo/portfolio-go/internal/domain"
	"github.com/SalvucciFacundo/portfolio-go/internal/i18n"
	"strings"
)

func sanitizeID(title string) string {
	return "modal-" + strings.ReplaceAll(strings.ToLower(title), " ", "-")
}

func getBentoClass(index int) string {
	switch index {
	case 0:
		return "project-card--tall"
	case 1:
		return "project-card--wide"
	case 2:
		return "project-card--medium"
	default:
		return ""
	}
}

script openModal(id string) {
	const dialog = document.getElementById(id);
	if (dialog) {
		dialog.showModal();
	}
}

script closeModal(id string) {
	const dialog = document.getElementById(id);
	if (dialog) {
		dialog.close();
	}
}

templ ProjectCard(p domain.Project, index int, lang string) {
	{{ id := sanitizeID(p.TitleEn) }}
	<article class={ "project-card", getBentoClass(index) } onclick={ openModal(id) }>
		<div class="project-card__cover">
			<img class="project-card__img grayscale-reveal" src={ p.CoverURL } alt={ i18n.L(p.TitleEs, p.TitleEn, lang) } width="800" height="500" loading="lazy"/>
			<div class="project-card__overlay"></div>
		</div>
		<div class="project-card__content">
			<span class="project-card__category">{ p.Category }</span>
			<h3 class="project-card__title">{ i18n.L(p.TitleEs, p.TitleEn, lang) }</h3>
			<ul class="project-card__tags">
				for _, t := range p.Tags {
					<li class="project-card__tag">{ t }</li>
				}
			</ul>
		</div>
		<button type="button" class="project-card__plus-btn" aria-label={ i18n.T(lang, "action.view_more") }>
			<span>+</span>
		</button>
	</article>
}

templ ProjectModal(p domain.Project, lang string) {
	{{ id := sanitizeID(p.TitleEn) }}
	{{ link := p.Link }}
	if link == "" {
		{{ link = "#" }}
	}
	<dialog id={ id } class="project-modal" onclick="if (event.target === this) this.close()">
		<div class="project-modal__content" onclick="event.stopPropagation()">
			<button class="project-modal__close-btn" onclick={ closeModal(id) } aria-label="Close modal">&times;</button>
			<div class="project-modal__header">
				<span class="project-modal__category">{ p.Category }</span>
				<h2 class="project-modal__title">{ i18n.L(p.TitleEs, p.TitleEn, lang) }</h2>
			</div>
			<div class="project-modal__body">
				<div class="project-modal__gallery-wrapper">
					<button type="button" class="project-modal__arrow project-modal__arrow--left" aria-label="Previous image">&larr;</button>
					<div class="project-modal__gallery">
						<img src={ p.CoverURL } alt={ i18n.L(p.TitleEs, p.TitleEn, lang) } width="800" height="500" />
					</div>
					<button type="button" class="project-modal__arrow project-modal__arrow--right" aria-label="Next image">&rarr;</button>
				</div>
				<hr class="project-modal__divider"/>
				<div class="project-modal__info">
					<p class="project-modal__desc">{ i18n.L(p.DescriptionEs, p.DescriptionEn, lang) }</p>
					<hr class="project-modal__divider"/>
					<p class="project-modal__tech-explanation">
						if lang == "en" {
							{ "Implemented with a clean architecture focused on modularity and high performance. It leverages a modern tech stack to ensure quick rendering times and robust data flow." }
						} else {
							{ "Implementado con una arquitectura limpia enfocada en la modularidad y el alto rendimiento. Aprovecha un stack tecnológico moderno para garantizar tiempos de respuesta rápidos y flujos de datos sólidos." }
						}
					</p>
					<div class="project-modal__meta">
						<span class="project-modal__meta-label">Stack:</span>
						<ul class="project-modal__tags">
							for _, t := range p.Tags {
								<li class="project-modal__tag">{ t }</li>
							}
						</ul>
					</div>
				</div>
			</div>
			<div class="project-modal__footer">
				<a class="btn btn--primary" href={ link } target="_blank" rel="noopener noreferrer">{ i18n.T(lang, "action.view_live") }</a>
				if p.RepoLink != "" {
					<a class="btn btn--secondary" href={ p.RepoLink } target="_blank" rel="noopener noreferrer">
						<span>GitHub</span>
					</a>
				}
			</div>
		</div>
	</dialog>
}
