package layouts

import (
	"github.com/SalvucciFacundo/portfolio-go/internal/i18n"
)

templ Base(lang string) {
	<!DOCTYPE html>
	<html lang={ lang }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content={ i18n.T(lang, "meta.description") }/>
			<meta property="og:type" content="website"/>
			<meta property="og:title" content="Facundo Salvucci — Portfolio"/>
			<meta property="og:description" content={ i18n.T(lang, "meta.description") }/>
			<meta property="og:locale" content={ lang }/>
			<meta name="twitter:card" content="summary"/>
			<meta name="twitter:title" content="Facundo Salvucci — Portfolio"/>
			<title>Facundo Salvucci — Portfolio</title>
			<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231A1A1A'/%3E%3Ctext x='16' y='22' font-family='monospace' font-size='15' fill='%23F4F4F2' text-anchor='middle'%3EF%3C/text%3E%3C/svg%3E"/>
			<script>
				(function () {
					try {
						var t = localStorage.getItem('theme');
						if (!t) {
							t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
						}
						if (t === 'dark') {
							document.documentElement.classList.add('dark-theme');
						}
					} catch (e) {}
				})();
			</script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/tokens.css"/>
			<link rel="stylesheet" href="/static/css/base.css"/>
			<link rel="stylesheet" href="/static/css/components.css"/>
			<script src="/static/js/htmx.min.js"></script>
			<script src={ "/static/js/admin.js?v=" + assetVersion() }></script>
		</head>
		<body>
			{ children... }
			<script>
				(function () {
					var root = document.documentElement;

					var themeBtn = document.getElementById('theme-toggle');
					if (themeBtn) {
						var apply = function () {
							themeBtn.setAttribute('aria-pressed', String(root.classList.contains('dark-theme')));
						};
						themeBtn.addEventListener('click', function () {
							var dark = root.classList.toggle('dark-theme');
							try {
								localStorage.setItem('theme', dark ? 'dark' : 'light');
							} catch (e) {}
							apply();
						});
						apply();
					}

					document.querySelectorAll('.copy-email').forEach(function (btn) {
						btn.addEventListener('click', function () {
							var email = btn.getAttribute('data-email');
							if (!email) {
								return;
							}
							var feedback = btn.querySelector('.copy-email__feedback');
							var done = function () {
								if (feedback) {
									feedback.classList.add('is-visible');
									setTimeout(function () {
										feedback.classList.remove('is-visible');
									}, 2000);
								}
							};
							if (navigator.clipboard && navigator.clipboard.writeText) {
								navigator.clipboard.writeText(email).then(done).catch(function () {});
							}
						});
					});

					// ── Interactive Project Gallery Carousel ──
					window.navigateGallery = function (btn, dir) {
						var wrapper = btn.closest('.project-modal__gallery-wrapper');
						var images = wrapper.getAttribute('data-images').split(',');
						var index = parseInt(wrapper.getAttribute('data-index') || '0', 10);
						index = (index + dir + images.length) % images.length;
						wrapper.setAttribute('data-index', index);
						var img = wrapper.querySelector('.project-modal__gallery img');
						if (img) {
							img.src = images[index];
						}
					};

					// ── Fullscreen Lightbox Zoom ──
					window.openLightbox = function (el) {
						var src = el.src;
						var wrapper = el.closest('.project-modal__gallery-wrapper');
						var images = wrapper ? wrapper.getAttribute('data-images').split(',') : [src];
						var currentIndex = wrapper ? parseInt(wrapper.getAttribute('data-index') || '0', 10) : 0;

						// Crear dialog para evitar que el transform del modal padre restrinja el tamaño del visor
						var dialog = document.createElement('dialog');
						dialog.className = 'lightbox-dialog';
						dialog.style.cssText = 'border: none; background: transparent; padding: 0; margin: 0; width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh; position: fixed; inset: 0; z-index: 999999; display: flex; align-items: center; justify-content: center; overflow: hidden;';

						// Estilo dinámico para el backdrop del dialog (desenfoque y fondo oscuro)
						var style = document.createElement('style');
						style.innerHTML = '.lightbox-dialog::backdrop { background: rgba(0, 0, 0, 0.96); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }';
						dialog.appendChild(style);

						var img = document.createElement('img');
						img.src = src;
						img.style.cssText = 'max-width: 95vw; max-height: 95vh; object-fit: contain; border-radius: 8px; box-shadow: 0 24px 50px rgba(0,0,0,0.6); transform-origin: center; user-select: none; -webkit-user-drag: none; transition: transform 0.15s ease-out; cursor: zoom-in;';

						var currentScale = 1;
						var minScale = 1;
						var maxScale = 5;
						var posX = 0;
						var posY = 0;

						function updateTransform(useTransition) {
							img.style.transition = useTransition ? 'transform 0.15s ease-out' : 'none';
							img.style.transform = 'translate(' + posX + 'px, ' + posY + 'px) scale(' + currentScale + ')';
						}

						// Zoom con la Rueda del Mouse (Wheel)
						dialog.addEventListener('wheel', function (e) {
							e.preventDefault();
							var zoomIntensity = 0.15;
							var delta = e.deltaY < 0 ? 1 : -1;
							
							currentScale = Math.min(Math.max(currentScale + delta * zoomIntensity, minScale), maxScale);
							
							if (currentScale > 1) {
								img.style.cursor = 'grab';
							} else {
								img.style.cursor = 'zoom-in';
								posX = 0;
								posY = 0;
							}
							
							updateTransform(true);
						}, { passive: false });

						// Arrastre y Paneo con el mouse
						var isDragging = false;
						var startX = 0;
						var startY = 0;

						img.addEventListener('mousedown', function (e) {
							if (currentScale <= 1) return;
							e.preventDefault();
							e.stopPropagation();
							isDragging = true;
							img.style.cursor = 'grabbing';
							startX = e.clientX - posX;
							startY = e.clientY - posY;
						});

						var onMouseMove = function (e) {
							if (!isDragging) return;
							posX = e.clientX - startX;
							posY = e.clientY - startY;
							updateTransform(false);
						};

						var onMouseUp = function () {
							if (isDragging) {
								isDragging = false;
								img.style.cursor = 'grab';
							}
						};

						window.addEventListener('mousemove', onMouseMove);
						window.addEventListener('mouseup', onMouseUp);

						var closeBtn = document.createElement('button');
						closeBtn.innerHTML = '&times;';
						closeBtn.style.cssText = 'position: absolute; top: 1.5rem; right: 1.5rem; width: 48px; height: 48px; font-size: 3rem; line-height: 1; color: rgba(255, 255, 255, 0.7); background: transparent; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 1000000; transition: color 150ms ease, transform 150ms ease;';
						
						closeBtn.addEventListener('mouseenter', function () {
							closeBtn.style.color = '#ffffff';
							closeBtn.style.transform = 'scale(1.1)';
						});
						closeBtn.addEventListener('mouseleave', function () {
							closeBtn.style.color = 'rgba(255, 255, 255, 0.7)';
							closeBtn.style.transform = 'scale(1)';
						});

						function updateImage(idx) {
							currentIndex = idx;
							img.src = images[currentIndex];
							
							// Resetear escala y offsets al cambiar de imagen
							currentScale = 1;
							posX = 0;
							posY = 0;
							img.style.cursor = 'zoom-in';
							updateTransform(true);

							// Sincronizar el carrusel de fondo del modal
							if (wrapper) {
								wrapper.setAttribute('data-index', currentIndex);
								var modalImg = wrapper.querySelector('.project-modal__gallery img');
								if (modalImg) {
									modalImg.src = images[currentIndex];
								}
							}
						}

						function navigate(dir) {
							var nextIdx = (currentIndex + dir + images.length) % images.length;
							updateImage(nextIdx);
						}

						var keyHandler;

						// Si hay múltiples imágenes, renderizar controles y habilitar gestos/teclado
						if (images.length > 1) {
							var leftArrow = document.createElement('button');
							leftArrow.innerHTML = '&larr;';
							leftArrow.style.cssText = 'position: absolute; left: 1.5rem; top: 50%; transform: translateY(-50%); width: 48px; height: 48px; font-size: 2rem; background: rgba(0,0,0,0.5); color: #fff; border: 1px solid rgba(255,255,255,0.2); border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 1000000; transition: all 0.2s ease;';
							leftArrow.addEventListener('click', function (e) {
								e.stopPropagation();
								navigate(-1);
							});
							leftArrow.addEventListener('mouseenter', function () { leftArrow.style.background = '#22c55e'; leftArrow.style.borderColor = '#22c55e'; });
							leftArrow.addEventListener('mouseleave', function () { leftArrow.style.background = 'rgba(0,0,0,0.5)'; leftArrow.style.borderColor = 'rgba(255,255,255,0.2)'; });

							var rightArrow = document.createElement('button');
							rightArrow.innerHTML = '&rarr;';
							rightArrow.style.cssText = 'position: absolute; right: 1.5rem; top: 50%; transform: translateY(-50%); width: 48px; height: 48px; font-size: 2rem; background: rgba(0,0,0,0.5); color: #fff; border: 1px solid rgba(255,255,255,0.2); border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 1000000; transition: all 0.2s ease;';
							rightArrow.addEventListener('click', function (e) {
								e.stopPropagation();
								navigate(1);
							});
							rightArrow.addEventListener('mouseenter', function () { rightArrow.style.background = '#22c55e'; rightArrow.style.borderColor = '#22c55e'; });
							rightArrow.addEventListener('mouseleave', function () { rightArrow.style.background = 'rgba(0,0,0,0.5)'; rightArrow.style.borderColor = 'rgba(255,255,255,0.2)'; });

							dialog.appendChild(leftArrow);
							dialog.appendChild(rightArrow);

							// Soporte para flechas físicas del teclado en Lightbox
							keyHandler = function (e) {
								if (e.key === 'ArrowLeft') {
									navigate(-1);
								} else if (e.key === 'ArrowRight') {
									navigate(1);
								} else if (e.key === 'Escape') {
									closeLightbox();
								}
							};
							window.addEventListener('keydown', keyHandler);
						}

						function closeLightbox() {
							dialog.style.opacity = '0';
							img.style.transform = 'scale(0.95)';
							if (images.length > 1 && keyHandler) {
								window.removeEventListener('keydown', keyHandler);
							}
							window.removeEventListener('mousemove', onMouseMove);
							window.removeEventListener('mouseup', onMouseUp);
							setTimeout(function () {
								dialog.close();
								dialog.remove();
							}, 150);
						}

						dialog.addEventListener('click', function (e) {
							if (e.target === dialog) {
								closeLightbox();
							}
						});

						closeBtn.addEventListener('click', function (e) {
							e.stopPropagation();
							closeLightbox();
						});

						// Soporte táctil unificado (Swipe, Paneo por Touch y Pinch-to-Zoom)
						var isTouchDragging = false;
						var touchStartX = 0;
						var touchStartY = 0;
						var initialTouchDist = 0;
						var initialTouchScale = 1;

						dialog.addEventListener('touchstart', function (e) {
							if (e.touches.length === 1) {
								if (currentScale > 1) {
									isTouchDragging = true;
									touchStartX = e.touches[0].clientX - posX;
									touchStartY = e.touches[0].clientY - posY;
								} else {
									touchStartX = e.touches[0].clientX;
								}
							} else if (e.touches.length === 2) {
								isTouchDragging = false;
								initialTouchDist = Math.hypot(
									e.touches[0].clientX - e.touches[1].clientX,
									e.touches[0].clientY - e.touches[1].clientY
								);
								initialTouchScale = currentScale;
							}
						}, { passive: false });

						dialog.addEventListener('touchmove', function (e) {
							if (e.touches.length === 1 && isTouchDragging && currentScale > 1) {
								e.preventDefault(); // Prevenir rebote/scroll nativo del navegador móvil
								posX = e.touches[0].clientX - touchStartX;
								posY = e.touches[0].clientY - touchStartY;
								updateTransform(false);
							} else if (e.touches.length === 2 && initialTouchDist > 0) {
								e.preventDefault(); // Evitar que el navegador móvil haga zoom sobre toda la web
								var dist = Math.hypot(
									e.touches[0].clientX - e.touches[1].clientX,
									e.touches[0].clientY - e.touches[1].clientY
								);
								var factor = dist / initialTouchDist;
								currentScale = Math.min(Math.max(initialTouchScale * factor, minScale), maxScale);
								
								if (currentScale > 1) {
									img.style.cursor = 'grab';
								} else {
									img.style.cursor = 'zoom-in';
									posX = 0;
									posY = 0;
								}
								updateTransform(false);
							}
						}, { passive: false });

						dialog.addEventListener('touchend', function (e) {
							if (isTouchDragging) {
								isTouchDragging = false;
							}
							if (e.touches.length === 0 && currentScale === 1 && images.length > 1) {
								var touchEndX = e.changedTouches[0].clientX;
								var diff = touchEndX - touchStartX;
								if (Math.abs(diff) > 60) {
									if (diff > 0) {
										navigate(-1); // Swipe derecha -> anterior
									} else {
										navigate(1);  // Swipe izquierda -> siguiente
									}
								}
							}
							initialTouchDist = 0;
						}, { passive: true });

						dialog.appendChild(img);
						dialog.appendChild(closeBtn);
						document.body.appendChild(dialog);

						// Abrir modal en la capa superior (Top Layer)
						dialog.showModal();

						// Animación suave de aparición
						dialog.style.opacity = '0';
						dialog.style.transition = 'opacity 150ms ease';
						requestAnimationFrame(function () {
							dialog.style.opacity = '1';
						});
					};

					// ── Projects Slider navigation ──
					window.slideProjects = function (dir) {
						var slider = document.getElementById('projects-slider');
						if (!slider) return;
						var index = parseInt(slider.getAttribute('data-index') || '0', 10);
						var totalSlides = parseInt(slider.getAttribute('data-slides') || '1', 10);
						
						index = (index + dir + totalSlides) % totalSlides;
						slider.setAttribute('data-index', index);
						slider.style.transform = 'translateX(-' + (index * 100) + '%)';
					};

					// ── Fullscreen section navigator (Terminal screen swap) ──
					var allSections = Array.prototype.slice.call(document.querySelectorAll('.section'));
					var navLinks = Array.prototype.slice.call(document.querySelectorAll('.sidebar-right__link'));
					var currentIdx = 0;
					var isTransitioning = false;
					var LEAVE_MS = 350;
					var COOLDOWN_MS = 900;

					function updateNav(idx) {
						navLinks.forEach(function (a) {
							var target = a.getAttribute('href').replace('#', '');
							a.classList.toggle('is-active', allSections[idx] && allSections[idx].id === target);
						});
					}

					function goTo(nextIdx) {
						if (isTransitioning || nextIdx < 0 || nextIdx >= allSections.length || nextIdx === currentIdx) return;
						isTransitioning = true;

						// Phase 1: Fade out current section
						allSections[currentIdx].classList.remove('is-active');
						allSections[currentIdx].classList.add('is-leaving');

						setTimeout(function () {
							// Phase 2: Swap — hide old, show new instantly
							allSections[currentIdx].classList.remove('is-leaving');
							allSections[currentIdx].style.display = 'none';

							allSections[nextIdx].style.display = '';
							allSections[nextIdx].scrollIntoView({ behavior: 'instant' });

							// Phase 3: Fade in new section
							requestAnimationFrame(function () {
								allSections[nextIdx].classList.add('is-active');
								currentIdx = nextIdx;
								updateNav(currentIdx);

								setTimeout(function () {
									isTransitioning = false;
								}, COOLDOWN_MS);
							});
						}, LEAVE_MS);
					}

					// Initialize: hide all sections except the first if on desktop
					if (window.innerWidth > 900) {
						allSections.forEach(function (sec, i) {
							if (i === 0) {
								sec.classList.add('is-active');
							} else {
								sec.style.display = 'none';
							}
						});
						updateNav(0);
					} else {
						allSections.forEach(function (sec) {
							sec.classList.add('is-active');
							sec.style.display = '';
						});
					}

					// Wheel handler
					window.addEventListener('wheel', function (e) {
						if (window.innerWidth <= 900) return;

						// If any dialog modal is open, do not swap sections
						var activeDialog = document.querySelector('dialog[open]');
						if (activeDialog) {
							var path = e.composedPath();
							var insideDialog = false;
							for (var i = 0; i < path.length; i++) {
								if (path[i] === activeDialog) {
									insideDialog = true;
									break;
								}
							}
							if (insideDialog) {
								return; // Allow scrolling inside the open modal
							} else {
								e.preventDefault(); // Ignore scroll outside the modal
								return;
							}
						}

						// Check if scrolling inside the terminal log body
						var path = e.composedPath();
						for (var i = 0; i < path.length; i++) {
							var el = path[i];
							if (el === window || el === document) break;
							if (!el || !el.classList) continue;
							if (el.classList.contains('terminal-log__body')) {
								return; // Allow scrolling inside the terminal log
							}
						}

						e.preventDefault();
						var dir = e.deltaY > 0 ? 1 : -1;
						goTo(currentIdx + dir);
					}, { passive: false });

					// Sidebar nav click handler
					navLinks.forEach(function (a) {
						a.addEventListener('click', function (e) {
							if (window.innerWidth <= 900) return;
							e.preventDefault();
							var targetId = a.getAttribute('href').replace('#', '');
							for (var i = 0; i < allSections.length; i++) {
								if (allSections[i].id === targetId) {
									goTo(i);
									break;
								}
							}
						});
					});

					// Keyboard arrow support
					window.addEventListener('keydown', function (e) {
						if (window.innerWidth <= 900) return;
						if (e.key === 'ArrowDown' || e.key === 'PageDown') {
							e.preventDefault();
							goTo(currentIdx + 1);
						} else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
							e.preventDefault();
							goTo(currentIdx - 1);
						}
					});
				})();
			</script>
		</body>
	</html>
}
