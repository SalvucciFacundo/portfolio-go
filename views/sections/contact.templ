package sections

import (
	"github.com/SalvucciFacundo/portfolio-go/internal/domain"
	"github.com/SalvucciFacundo/portfolio-go/internal/i18n"
	"github.com/SalvucciFacundo/portfolio-go/views/components"
)

templ Contact(p domain.Profile, lang string) {
	<section id="contact" class="section contact">
		<h2 class="section__title">{ i18n.T(lang, "section.contact") }</h2>
		<p class="contact__text">{ i18n.T(lang, "contact.cta") }</p>
		<div class="contact__actions">
			@components.CopyEmail(p.Email, i18n.T(lang, "action.copy_email"), i18n.T(lang, "action.copied"), i18n.T(lang, "action.copy_email"))
		</div>
		@components.ContactForm(lang, "", "", "", "", false)
	</section>
}
