package sections

import (
	"github.com/SalvucciFacundo/portfolio-go/internal/domain"
	"github.com/SalvucciFacundo/portfolio-go/internal/i18n"
	"github.com/SalvucciFacundo/portfolio-go/views/components"
)

templ Projects(p domain.Profile, lang string, isAdmin bool) {
	<section id="projects" class="section">
		if isAdmin {
			@components.AdminEditBtn("projects-admin-modal")
		}
		<h2 class="section__title">{ i18n.T(lang, "section.projects") }</h2>
		<div class="projects-grid">
			for i, pr := range p.Projects {
				@components.ProjectCard(pr, i, lang)
			}
		</div>
		for _, pr := range p.Projects {
			@components.ProjectModal(pr, lang)
		}
	</section>
}
