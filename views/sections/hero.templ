package sections

import (
	"github.com/SalvucciFacundo/portfolio-go/internal/domain"
	"github.com/SalvucciFacundo/portfolio-go/internal/i18n"
	"github.com/SalvucciFacundo/portfolio-go/views/components"
)

templ Hero(p domain.Profile, lang string) {
	<section id="hero" class="section hero">
		<div class="hero__number" aria-hidden="true">01</div>
		<div class="hero__software-bar">
			<span class="hero__software-file">{ "// main.go" }</span>
			<span class="hero__software-tag">[EXEC: OK]</span>
			<span class="hero__software-dots"><span class="dot">{ "." }</span><span class="dot">{ "." }</span><span class="dot">{ "." }</span></span>
		</div>
		<div class="hero__body">
			<div class="hero__gutter" aria-hidden="true">
				<span>01</span>
				<span>02</span>
				<span>03</span>
				<span>04</span>
				<span>05</span>
			</div>
			<div class="hero__media-floated">
				<div class="hero__backtext" aria-hidden="true">
					<span>developer</span>
					<span>designer</span>
				</div>
				@components.VinylAvatar(p)
			</div>
			<div class="hero__intro">
				<p class="hero__greeting">
					<span class="hero__status-tag">SYS.INIT <span class="hero__caret" aria-hidden="true">▌</span></span>
					<span class="hero__code-prefix">{ "func main() {" }</span>
					<span>{ i18n.T(lang, "hero.greeting") }</span>
				</p>
				<h1 class="hero__name">{ p.Name }</h1>
				<div class="hero__role-wrapper">
					<div class="hero__role-card">
						<div class="hero__role-card-back" aria-hidden="true"></div>
						<div class="hero__role-card-front">
							<span class="hero__pulse-dot"></span>
							<span>{ i18n.L(p.RoleEs, p.RoleEn, lang) }</span>
						</div>
					</div>
				</div>
				<div class="hero__text">
					<p class="hero__headline">{ i18n.L(p.HeadlineEs, p.HeadlineEn, lang) }</p>
					if p.SummaryEs != "" || p.SummaryEn != "" {
						<p class="hero__summary">{ i18n.L(p.SummaryEs, p.SummaryEn, lang) }</p>
					}
					<p class="hero__code-suffix">{ "}" }</p>
				</div>
				<div class="hero__actions">
					if p.ResumeURL != "" {
						<a class="btn-3d" href={ p.ResumeURL }>
							<span class="btn-3d__back"></span>
							<span class="btn-3d__front">{ i18n.T(lang, "action.download_cv") }</span>
						</a>
					} else {
						<button type="button" class="btn-3d" disabled>
							<span class="btn-3d__back"></span>
							<span class="btn-3d__front">{ i18n.T(lang, "action.download_cv") }</span>
						</button>
					}
				</div>
			</div>
		</div>
	</section>
}