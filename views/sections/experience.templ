package sections

import (
	"github.com/SalvucciFacundo/portfolio-go/internal/domain"
	"github.com/SalvucciFacundo/portfolio-go/internal/i18n"
	"github.com/SalvucciFacundo/portfolio-go/views/components"
)

templ Experience(p domain.Profile, lang string, isAdmin bool) {
	<section id="experience" class="section">
		if isAdmin {
			@components.AdminEditBtn("experience-admin-modal")
		}
		<h2 class="section__title">{ i18n.T(lang, "section.experience") }</h2>
		<ol class="timeline">
			for _, e := range p.Experience {
				@components.ExperienceItem(e, lang)
			}
		</ol>
	</section>
}
