package sections

import (
	"github.com/SalvucciFacundo/portfolio-go/internal/domain"
	"github.com/SalvucciFacundo/portfolio-go/internal/i18n"
	"github.com/SalvucciFacundo/portfolio-go/views/components"
)

templ Skills(p domain.Profile, lang string, isAdmin bool) {
	<section id="skills" class="section">
		if isAdmin {
			@components.AdminEditBtn("skills-admin-modal")
		}
		<h2 class="section__title">{ i18n.T(lang, "section.skills") }</h2>
		
		<div class="skills-section">
			<h3 class="skills-section__subtitle">
				if lang == "en" {
					Technologies
				} else {
					Tecnologías
				}
			</h3>
			<div class="skills-grid">
				for _, s := range p.Skills {
					if !s.IsTool {
						@components.SkillCard(s, lang)
					}
				}
			</div>
		</div>

		<div class="skills-section">
			<h3 class="skills-section__subtitle">
				if lang == "en" {
					Tools
				} else {
					Herramientas
				}
			</h3>
			<div class="skills-grid">
				for _, s := range p.Skills {
					if s.IsTool {
						@components.SkillCard(s, lang)
					}
				}
			</div>
		</div>
	</section>
}
